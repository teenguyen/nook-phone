{
  "name": "@teenguyen/nook-phone",
  "version": "0.1.0",
  "private": false,
  "description": "Static Nook Phone UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teenguyen/nook-phone.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "index.html",
    "css",
    "js",
    "assets"
  ],
  "scripts": {
    "dev": "npx --yes serve@14.2.4 . -l 3000",
    "start": "npx --yes serve@14.2.4 . -l 3000",
    "pack:dry": "npm pack --dry-run",
    "docker:build": "docker build -t nook-phone .",
    "docker:up": "docker compose up --build",
    "docker:watch": "docker compose watch",
    "docker:down": "docker compose down",
    "prepublishOnly": "npm run pack:dry"
  },
  "engines": {
    "node": ">=18"
  }
}
